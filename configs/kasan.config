# KASAN 版本：記憶體錯誤偵測（適合 bug 重現 / 回報）

CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y
CONFIG_KASAN_INLINE=y

# 註：KCOV（全程式插樁）只有 syzkaller fuzzing 才需要，且在 TCG/gdb 下會
# 大幅拖慢執行。重現/除錯 bug 不需要，故預設不開。要做 syzkaller 時再加：
#   CONFIG_KCOV=y
#   CONFIG_KCOV_INSTRUMENT_ALL=y
#   CONFIG_KCOV_ENABLE_COMPARISONS=y

# 其他偵測器
CONFIG_DEBUG_KERNEL=y
CONFIG_KASAN_VMALLOC=y
CONFIG_SLUB_DEBUG=y
CONFIG_DEBUG_STACKOVERFLOW=y

# KASAN 會放大 stack frame，避免 warning 中斷編譯
CONFIG_FRAME_WARN=0

# 方便符號化（KASAN report 需要可讀的 call trace）
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
