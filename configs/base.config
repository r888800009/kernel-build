# 所有變體共用的基礎設定（套在 defconfig 之上）
# 目標：可在 QEMU/KVM guest 內開機測試的最小可用組態（syzkaller 風格）

# --- 虛擬化 guest 支援 ---
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y

# --- virtio 裝置（開機/磁碟/網路/console）---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y

# --- 檔案系統 ---
CONFIG_EXT4_FS=y
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y

# --- 開機必要 ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_MISC=y
CONFIG_CMDLINE_BOOL=y

# --- 網路基礎 ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
