# symbol 版本：完整 debug 符號，方便 crash 分析 / gdb / vmlinux 符號化

CONFIG_DEBUG_KERNEL=y

# 完整 DWARF debug info
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_DWARF5=y
CONFIG_DEBUG_INFO_REDUCED=n
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y

# BTF（供 bpftool / drgn 等工具使用；需要 dwarves/pahole）
CONFIG_DEBUG_INFO_BTF=y

# 完整符號表
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# gdb 輔助腳本（vmlinux-gdb.py）
CONFIG_GDB_SCRIPTS=y

# 刻意不關閉 KASLR（不設 CONFIG_RANDOMIZE_BASE=n）：
# 保留 ASLR 才能觀察/分析實際的位址分布，與真實執行環境一致。
# 除錯時以 System.map + vmlinux 搭配執行期 base 位址做符號化即可。

# frame pointer 讓 backtrace 更準確
CONFIG_FRAME_POINTER=y
